# Application
APP_NAME=SkinMatch
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=skinmatch
POSTGRES_PASSWORD=skinmatch
POSTGRES_DB=skinmatch
DATABASE_URL=postgresql+psycopg2://skinmatch:skinmatch@postgres:5432/skinmatch

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# AI module
AI_ANALYZER=heuristic
AI_MODEL_PATH=./app/ai/models/skin_model.onnx

# Security (mock for MVP — replace with real JWT secret in production)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
